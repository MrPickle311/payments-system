<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="1" author="gemini">
        <createTable tableName="payments">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="transaction_id" type="text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="amount" type="decimal(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="fraud_score" type="int"/>
            <column name="fraud_risk" type="text"/>
            <column name="source_user_id" type="bigint"/>
            <column name="target_user_id" type="bigint"/>
            <column name="source_currency" type="text"/>
            <column name="target_currency" type="text"/>
            <column name="fee_amount" type="decimal(19,4)"/>
            <column name="net_amount" type="decimal(19,4)"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp"/>
            <column name="version" type="bigint"/>
        </createTable>

        <createTable tableName="payment_history">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="payment_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="region" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="from_state" type="text"/>
            <column name="to_state" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="event" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="timestamp" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="outbox_events">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="aggregate_id" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="topic" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="processed" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!--
      Durable, cross-process guard + work queue for parallel-saga join dispatch.
      UNIQUE (payment_id, join_key) is the guard: whoever inserts the row owns the dispatch.
    -->
    <changeSet id="2" author="claude">
        <createTable tableName="saga_pending_events">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="payment_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="event" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="join_key" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="text"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp"/>
        </createTable>

        <addUniqueConstraint
                tableName="saga_pending_events"
                columnNames="payment_id, join_key"
                constraintName="uk_saga_pending_events_payment_join"/>

        <createIndex tableName="saga_pending_events" indexName="idx_saga_pending_events_status">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!--
      Lease columns for the layer-1 recovery poller: UNIQUE (payment_id, join_key) arbitrates the
      first claim, but not a retry of an existing PENDING row. A time-boxed conditional-update lease
      makes exactly one polling pod win each row per sweep.
    -->
    <changeSet id="3" author="claude">
        <addColumn tableName="saga_pending_events">
            <column name="locked_by" type="text"/>
            <column name="locked_until" type="timestamp"/>
        </addColumn>

        <createIndex tableName="saga_pending_events" indexName="idx_saga_pending_events_lease">
            <column name="status"/>
            <column name="locked_until"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
