@startuml
skinparam state {
  BackgroundColor White
  BorderColor Black
}

title Payment State Machine with Orthogonal Regions

[*] --> NEW

NEW --> FX_CONVERSION : INITIATE

state FX_CONVERSION {
  FX_CONVERSION : entry / syncFxCall
}
FX_CONVERSION --> PROCESSING : FX_SUCCESS
FX_CONVERSION --> FAILED : FX_FAIL

state PROCESSING {
  state Authorization {
    [*] --> AUTH_PENDING
    AUTH_PENDING : entry / authorization

    AUTH_PENDING --> AUTH_APPROVED : AUTH_SUCCESS
    AUTH_PENDING --> AUTH_REJECTED : AUTH_REJECT
    AUTH_PENDING --> AUTH_FAILED : AUTH_FAIL
  }

  --

  state FraudCheck {
    [*] --> FRAUD_EVALUATING
    FRAUD_EVALUATING : entry / fraudCheck
    FRAUD_EVALUATING --> FRAUD_PASSED  : FRAUD_CLEAR
    FRAUD_EVALUATING --> FRAUD_DETECTED : FRAUD_ALERT
    FRAUD_EVALUATING --> FRAUD_FAILED : FRAUD_FAIL
  }

  --

  state LimitsCheck {
    [*] --> LIMITS_EVALUATING
    LIMITS_EVALUATING : entry / limitsCheck
    LIMITS_EVALUATING --> LIMITS_OK : LIMITS_CLEAR
    LIMITS_EVALUATING --> LIMITS_EXCEEDED : LIMITS_REJECT
    LIMITS_EVALUATING --> LIMITS_FAILED : LIMITS_FAIL
  }

  --

  state SanctionsCheck {
    [*] --> SANCTIONS_EVALUATING
    SANCTIONS_EVALUATING : entry / sanctionsCheck
    SANCTIONS_EVALUATING --> SANCTIONS_CLEARED : SANCTIONS_PASS
    SANCTIONS_EVALUATING --> SANCTIONS_HIT : SANCTIONS_HIT
    SANCTIONS_EVALUATING --> SANCTIONS_FAILED : SANCTIONS_FAIL
  }

  --

  state FeeCheck {
    [*] --> FEE_EVALUATING
    FEE_EVALUATING : entry / feeCalculation
    FEE_EVALUATING --> FEE_CALCULATED : FEE_CALC_SUCCESS
    FEE_CALCULATED : entry / feeCharge
    FEE_CALCULATED --> FEE_CHARGED : FEE_CHARGE_SUCCESS
    FEE_EVALUATING --> FEE_FAILED : FEE_CALC_FAIL
    FEE_CALCULATED --> FEE_FAILED : FEE_CHARGE_FAIL
  }
}

PROCESSING --> SETTLEMENT : COMPLETE

state SETTLEMENT {
  [*] --> WALLET_SETTLEMENT
  WALLET_SETTLEMENT : entry / walletSettlement
  WALLET_SETTLEMENT --> WALLET_SETTLED : WALLET_SETTLED_SUCCESS
  WALLET_SETTLEMENT --> SETTLEMENT_FAILED : WALLET_SETTLED_FAIL
  WALLET_SETTLED : entry / ledgerNotification
  WALLET_SETTLED --> LEDGER_NOTIFIED : LEDGER_NOTIFY_SUCCESS
  WALLET_SETTLED --> LEDGER_NOTIFICATION_FAILED : LEDGER_NOTIFY_FAIL
}

SETTLEMENT --> COMPLETED : SETTLEMENT_SUCCESS
SETTLEMENT --> COMPENSATING : SETTLEMENT_FAIL

PROCESSING --> COMPENSATING : FAIL

state COMPENSATING {
  state FeeCompensation {
    [*] --> FEE_EVALUATING_COMPENSATION
    FEE_EVALUATING_COMPENSATION --> FEE_COMPENSATING : [feeCharged]
    FEE_EVALUATING_COMPENSATION --> FEE_COMPENSATION_SKIPPED : [!feeCharged]
    FEE_COMPENSATING : entry / compensateFee
    FEE_COMPENSATING --> FEE_COMPENSATED : FEE_COMPENSATE_SUCCESS
  }

  --

  state LimitsCompensation {
    [*] --> LIMITS_EVALUATING_COMPENSATION
    LIMITS_EVALUATING_COMPENSATION --> LIMITS_COMPENSATING : [limitsOk]
    LIMITS_EVALUATING_COMPENSATION --> LIMITS_COMPENSATION_SKIPPED : [!limitsOk]
    LIMITS_COMPENSATING : entry / compensateLimits
    LIMITS_COMPENSATING --> LIMITS_COMPENSATED : LIMITS_COMPENSATE_SUCCESS
  }
}

COMPENSATING --> FAILED : FAIL

state COMPLETED {
  COMPLETED : entry / completedEntry
}

state FAILED {
  FAILED : entry / failedEntry
}


@enduml
